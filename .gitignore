*.log
logs/

# Photos / arrivals media (object storage in production)
arrivals/photos/

# Firmware build artifacts
firmware/**/*.bin
firmware/**/*.elf
firmware/**/.pio/

# Terraform state
ops/terraform/.terraform/
ops/terraform/*.tfstate
ops/terraform/*.tfstate.backup

